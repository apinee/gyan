# Storage backend: "local" (SQLite, zero setup) or "monkdb"
GYAN_STORE=local
GYAN_DB_PATH=./data/gyan.db

# MonkDB connection (used when GYAN_STORE=monkdb)
MONKDB_HOST=localhost
MONKDB_API_PORT=4200
MONKDB_USER=testuser
MONKDB_PASSWORD=change-me
MONKDB_SCHEMA=gyan
# Set to 1 if your MonkDB license includes graph functions (graph_neighbors etc.)
MONKDB_NATIVE_GRAPH=0

# Distiller LLM: "anthropic" or "heuristic" (offline, no API calls)
GYAN_LLM=heuristic
ANTHROPIC_API_KEY=
GYAN_MODEL=claude-sonnet-5-5
GYAN_CARD_MODEL=claude-haiku-5-5

# Embeddings: "hash" (tiny, offline, for dev) or "sentence-transformers"
GYAN_EMBEDDER=hash
GYAN_EMBED_MODEL=sentence-transformers/all-mpnet-base-v2
GYAN_EMBED_DIM=768
